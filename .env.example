# Example environment variables for mcp-dev-toolkit
# Copy to .env and fill in your values

# PostgreSQL connection string example
# POSTGRES_DSN=postgresql://user:password@localhost:5432/mydb

# MySQL connection string example
# MYSQL_DSN=mysql://user:password@localhost:3306/mydb

# Optional: GitHub token for enhanced git operations
# GITHUB_TOKEN=ghp_...
